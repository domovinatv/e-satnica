{
  "name": "e-satnica",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "test": "node --test 'src/**/*.test.ts'",
    "deploy": "astro build && CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler deploy",
    "db:backup": "mkdir -p ../backups && CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler d1 export e-satnica --remote --output ../backups/d1-e-satnica-$(date +%Y%m%d-%H%M).sql",
    "db:status": "CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler d1 migrations list e-satnica --remote",
    "db:migrate": "CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler d1 migrations apply e-satnica --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@simplewebauthn/server": "^14.0.3",
    "astro": "^7.4.2",
    "jose": "^6.2.13",
    "wrangler": "^4.154.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}

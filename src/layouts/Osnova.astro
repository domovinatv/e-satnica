---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../styles/tokeni.css';
import PopisSekcija from '../components/PopisSekcija.astro';
import Vrh from '../components/Vrh.astro';
import Zaglavlje from '../components/Zaglavlje.astro';
import type { Slika } from '../lib/slike';
import type { SekcijaUPopisu } from '../lib/sekcije';

interface Props {
	naslov: string;
	// Kad su zadane, na desktopu stoje lijevo uz sadržaj; na mobitelu se ne prikazuju.
	sekcije?: SekcijaUPopisu[];
	aktivna?: string;
	/** Naslov u plavom vrhu, ako se razlikuje od naslova u kartici preglednika. */
	h1?: string;
	slika?: Slika;
	mrvice?: { href: string; tekst: string }[];
}
const { naslov, sekcije, aktivna, h1, slika, mrvice } = Astro.props;
---

<!doctype html>
<html lang="hr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{naslov} · e-satnica</title>
	</head>
	<body>
		<Zaglavlje />
		<Vrh naslov={h1 ?? naslov} slika={slika} mrvice={mrvice} />
		{
			sekcije ? (
				<div class="okvir">
					<aside class="lijevo">
						<PopisSekcija sekcije={sekcije} aktivna={aktivna} />
					</aside>
					<main class="desno">
						<slot />
					</main>
				</div>
			) : (
				<main class="sam">
					<slot />
				</main>
			)
		}
		<script is:inline type="module">
			// ```mermaid blokove iz specifikacije crta preglednik. Bez JavaScripta ostaje čitljiv izvorni tekst dijagrama.
			const blokovi = document.querySelectorAll('pre > code.language-mermaid');
			if (blokovi.length) {
				const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs');
				const tamno = matchMedia('(prefers-color-scheme: dark)');
				const cvorovi = [...blokovi].map((code) => {
					const div = document.createElement('div');
					div.className = 'mermaid';
					div.dataset.izvor = code.textContent;
					code.parentElement.replaceWith(div);
					return div;
				});
				const nacrtaj = async () => {
					mermaid.initialize({ startOnLoad: false, theme: tamno.matches ? 'dark' : 'default', securityLevel: 'strict' });
					for (const div of cvorovi) {
						div.removeAttribute('data-processed');
						div.textContent = div.dataset.izvor;
					}
					await mermaid.run({ nodes: cvorovi });
				};
				await nacrtaj();
				// Tema sustava se može promijeniti dok je stranica otvorena.
				tamno.addEventListener('change', nacrtaj);
			}
		</script>
	</body>
</html>

<style is:global>
	/* Boje su u styles/tokeni.css, zajedničke s javnim stranicama; ovdje samo stara imena. */
	:root {
		--plava: var(--more);
		--plava-svijetla: var(--nebo);
		--tekst: var(--tinta);
		--rub: var(--crta);
		--pozadina: var(--papir);
	}
	* { box-sizing: border-box; }
	body {
		margin: 0;
		font: 17px/1.6 var(--sans);
		color: var(--tekst);
		background: var(--pozadina);
	}
	main { padding: 16px 16px 64px; }
	.sam, .desno { max-width: 760px; margin: 0 auto; }
	.lijevo { display: none; }

	@media (min-width: 960px) {
		.okvir {
			display: grid;
			grid-template-columns: 340px minmax(0, 1fr);
		}
		.lijevo {
			display: block;
			position: sticky;
			top: 0;
			height: 100vh;
			overflow-y: auto;
			padding: 16px;
			border-right: 1px solid var(--rub);
		}
		.desno {
			max-width: 860px;
			margin: 0;
			padding: 16px 40px 64px;
		}
		.samo-mobitel { display: none; }
	}
	@media (max-width: 959px) {
		.samo-desktop { display: none; }
	}

	.mermaid { margin: 16px 0; overflow-x: auto; text-align: center; }
	blockquote { margin: 16px 0; padding: 8px 16px; border-left: 4px solid var(--plava); background: var(--plava-svijetla); }
	a { color: var(--plava); }
	h1 { line-height: 1.25; font-family: var(--serif); font-weight: 600; }
	table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
	th, td { border: 1px solid var(--rub); padding: 6px 8px; text-align: left; vertical-align: top; }
	label { display: block; font-weight: 600; margin: 12px 0 4px; }
	input, select, textarea {
		width: 100%;
		font: inherit;
		padding: 10px;
		border: 1px solid var(--rub);
		border-radius: 8px;
		background: var(--pozadina);
		color: var(--tekst);
	}
	textarea { min-height: 120px; }
	button {
		margin-top: 12px;
		font: inherit;
		font-weight: 600;
		padding: 10px 18px;
		border: 0;
		border-radius: 8px;
		background: #0e3f8c;
		color: #fff;
		cursor: pointer;
	}
	.kartica { border: 1px solid var(--rub); border-radius: 10px; padding: 12px 14px; margin: 10px 0; }
	.meta { color: var(--siva); font-size: 14px; }
	.oznaka {
		display: inline-block;
		font-size: 13px;
		padding: 1px 8px;
		border-radius: 999px;
		background: var(--plava-svijetla);
		color: var(--plava);
		margin-right: 6px;
	}
	.greska { color: #dc2626; }
</style>

---
import PopisSekcija from '../components/PopisSekcija.astro';
import type { SekcijaUPopisu } from '../lib/sekcije';

interface Props {
	naslov: string;
	// Kad su zadane, na desktopu stoje lijevo uz sadržaj; na mobitelu se ne prikazuju.
	sekcije?: SekcijaUPopisu[];
	aktivna?: string;
}
const { naslov, sekcije, aktivna } = Astro.props;
const ime = Astro.locals.ime;
---

<!doctype html>
<html lang="hr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{naslov} · e-satnica</title>
	</head>
	<body>
		<header>
			<a href="/specifikacija" class="logo">e-satnica</a>
			{
				ime && (
					<form method="post" action="/odjava" class="tko">
						{ime} · {Astro.locals.korisnikId && <><a href="/kljucevi">Ključevi</a> · </>}
						<button type="submit" class="odjava">Odjava</button>
					</form>
				)
			}
		</header>
		{
			sekcije ? (
				<div class="okvir">
					<aside class="lijevo">
						<PopisSekcija sekcije={sekcije} aktivna={aktivna} />
					</aside>
					<main class="desno">
						<slot />
					</main>
				</div>
			) : (
				<main class="sam">
					<slot />
				</main>
			)
		}
		<script is:inline type="module">
			// ```mermaid blokove iz specifikacije crta preglednik. Bez JavaScripta ostaje čitljiv izvorni tekst dijagrama.
			const blokovi = document.querySelectorAll('pre > code.language-mermaid');
			if (blokovi.length) {
				const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs');
				const tamno = matchMedia('(prefers-color-scheme: dark)').matches;
				mermaid.initialize({ startOnLoad: false, theme: tamno ? 'dark' : 'default', securityLevel: 'strict' });
				const cvorovi = [...blokovi].map((code) => {
					const div = document.createElement('div');
					div.className = 'mermaid';
					div.textContent = code.textContent;
					code.parentElement.replaceWith(div);
					return div;
				});
				await mermaid.run({ nodes: cvorovi });
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--plava: #1d4ed8;
		--plava-svijetla: #eff4ff;
		--tekst: #1f2937;
		--siva: #6b7280;
		--rub: #e5e7eb;
		--pozadina: #ffffff;
		--zaglavlje: 53px;
		color-scheme: light dark;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--plava: #7aa2ff;
			--plava-svijetla: #172036;
			--tekst: #e5e7eb;
			--siva: #9ca3af;
			--rub: #2d3748;
			--pozadina: #0f1420;
		}
	}
	* { box-sizing: border-box; }
	body {
		margin: 0;
		font: 17px/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif;
		color: var(--tekst);
		background: var(--pozadina);
	}
	header {
		position: sticky;
		top: 0;
		z-index: 1;
		height: var(--zaglavlje);
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 16px;
		border-bottom: 1px solid var(--rub);
		background: var(--pozadina);
	}
	.logo { font-weight: 700; color: var(--plava); text-decoration: none; font-size: 20px; }
	.tko { color: var(--siva); font-size: 15px; }
	.odjava { margin: 0; padding: 0; background: none; color: var(--plava); font-weight: 400; font-size: 15px; }
	main { padding: 16px 16px 64px; }
	.sam, .desno { max-width: 760px; margin: 0 auto; }
	.lijevo { display: none; }

	@media (min-width: 960px) {
		.okvir {
			display: grid;
			grid-template-columns: 340px minmax(0, 1fr);
		}
		.lijevo {
			display: block;
			position: sticky;
			top: var(--zaglavlje);
			height: calc(100vh - var(--zaglavlje));
			overflow-y: auto;
			padding: 16px;
			border-right: 1px solid var(--rub);
		}
		.desno {
			max-width: 860px;
			margin: 0;
			padding: 16px 40px 64px;
		}
		.samo-mobitel { display: none; }
	}
	@media (max-width: 959px) {
		.samo-desktop { display: none; }
	}

	.mermaid { margin: 16px 0; overflow-x: auto; text-align: center; }
	blockquote { margin: 16px 0; padding: 8px 16px; border-left: 4px solid var(--plava); background: var(--plava-svijetla); }
	a { color: var(--plava); }
	h1 { line-height: 1.25; }
	table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
	th, td { border: 1px solid var(--rub); padding: 6px 8px; text-align: left; vertical-align: top; }
	label { display: block; font-weight: 600; margin: 12px 0 4px; }
	input, select, textarea {
		width: 100%;
		font: inherit;
		padding: 10px;
		border: 1px solid var(--rub);
		border-radius: 8px;
		background: var(--pozadina);
		color: var(--tekst);
	}
	textarea { min-height: 120px; }
	button {
		margin-top: 12px;
		font: inherit;
		font-weight: 600;
		padding: 10px 18px;
		border: 0;
		border-radius: 8px;
		background: var(--plava);
		color: #fff;
		cursor: pointer;
	}
	.kartica { border: 1px solid var(--rub); border-radius: 10px; padding: 12px 14px; margin: 10px 0; }
	.meta { color: var(--siva); font-size: 14px; }
	.oznaka {
		display: inline-block;
		font-size: 13px;
		padding: 1px 8px;
		border-radius: 999px;
		background: var(--plava-svijetla);
		color: var(--plava);
		margin-right: 6px;
	}
	.greska { color: #dc2626; }
</style>

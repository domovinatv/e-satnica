---
import Osnova from '../layouts/Osnova.astro';
import { certiliaJePodesena } from '../lib/certilia/oidc';
import { KOLACIC, kodJeIspravan, kodTimaDopusten, kolacicOpcije, napraviSesiju, sigurnoNatrag } from '../lib/sesija';

export const prerender = false;

const GRESKE: Record<string, string> = {
	odustao: 'Prijava preko Certilije je prekinuta.',
	nije_podesena: 'Prijava preko Certilije još nije podešena.',
	neispravan_state: 'Prijava je istekla. Pokušaj ponovno.',
	nema_oiba: 'Certilia nije poslala OIB.',
	nema_imena: 'Certilia nije poslala ime i prezime.',
};

const p = Astro.url.searchParams;
const natrag = sigurnoNatrag(p.get('natrag'));
const certilia = certiliaJePodesena();
const kodTima = kodTimaDopusten();
const certiliaGreska = p.get('certilia_greska');
const debugClaimovi = p.get('certilia_claimovi');
let greska = '';

if (Astro.request.method === 'POST' && kodTima) {
	const podaci = await Astro.request.formData();
	const ime = String(podaci.get('ime') ?? '').trim().slice(0, 80);
	if (!ime) {
		greska = 'Upiši ime i prezime.';
	} else if (!kodJeIspravan(String(podaci.get('kod') ?? ''))) {
		greska = 'Kod nije ispravan.';
	} else {
		Astro.cookies.set(KOLACIC, await napraviSesiju({ ime, korisnikId: null, nacin: 'kod', od: Date.now() }), kolacicOpcije);
		return Astro.redirect(natrag);
	}
}
---

<Osnova naslov="Prijava">
	<h1>Prijava</h1>
	<p>Ovo je radni prostor tima e-satnice.</p>

	{
		certilia && (
			<a class="gumb" href={`/auth/certilia/start?natrag=${encodeURIComponent(natrag)}`}>
				Prijava s Certilijom
			</a>
		)
	}
	{certilia && <p class="meta"><a href="/upute">Kako se prijaviti (sa slikama)</a></p>}
	<div data-passkey>
		<button id="passkey-prijava" type="button" class="sporedni" data-natrag={natrag}>
			Prijava pristupnim ključem
		</button>
		<p class="meta">Ako je ključ na ovom uređaju već dodan nakon prijave Certilijom.</p>
		<p id="passkey-poruka" class="greska" hidden></p>
	</div>
	{certiliaGreska && <p class="greska">{GRESKE[certiliaGreska] ?? `Prijava nije uspjela (${certiliaGreska}).`}</p>}
	{
		debugClaimovi && (
			<div class="kartica">
				<strong>Certilia debug</strong>
				<div class="meta">Claimovi: {debugClaimovi}</div>
				<div class="meta">
					OIB iz: {p.get('oib_izvor')}, 11 znamenki: {p.get('oib_11_znamenki')}
				</div>
			</div>
		)
	}

	{
		kodTima && (
			<form method="post">
				{certilia && <p class="meta">Ili privremeno, kodom tima iz WhatsApp grupe:</p>}
				<label for="ime">Ime i prezime</label>
				<input id="ime" name="ime" autocomplete="name" required />
				<label for="kod">Kod tima</label>
				<input id="kod" name="kod" type="password" required />
				{greska && <p class="greska">{greska}</p>}
				<button type="submit">Uđi</button>
			</form>
		)
	}
</Osnova>

<script>
	import '../lib/passkey-klijent';
</script>

<style>
	.gumb {
		display: inline-block;
		margin: 8px 0 16px;
		padding: 12px 20px;
		border-radius: 8px;
		background: var(--plava);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	.sporedni {
		margin: 0 0 4px;
		background: none;
		color: var(--plava);
		border: 1px solid var(--plava);
	}
</style>

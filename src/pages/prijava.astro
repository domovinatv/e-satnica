---
import Osnova from '../layouts/Osnova.astro';
import { certiliaJePodesena } from '../lib/certilia/oidc';
import { POKUSAJ_KOLACIC, sigurnoNatrag } from '../lib/sesija';

export const prerender = false;

const GRESKE: Record<string, string> = {
	odustao: 'Prijava preko Certilije je prekinuta.',
	nije_podesena: 'Prijava preko Certilije još nije podešena.',
	neispravan_state: 'Prijava je istekla. Pokušaj ponovno.',
	nema_oiba: 'Certilia nije poslala OIB.',
	nema_imena: 'Certilia nije poslala ime i prezime.',
};

const p = Astro.url.searchParams;
const natrag = sigurnoNatrag(p.get('natrag'));
const certilia = certiliaJePodesena();
const certiliaGreska = p.get('certilia_greska');
const debugClaimovi = p.get('certilia_claimovi');
// Vratio se s Certilije bez prijave (greška, odustao ili napustio pa došao natrag).
const nijeUspjelo = certilia && (Boolean(certiliaGreska) || Astro.cookies.has(POKUSAJ_KOLACIC));
const VODIC = 'https://vodic.domovina.ai/?app=e-satnica';
---

<Osnova naslov="Prijava">
	<h1>Prijava</h1>
	<p>Ovo je radni prostor tima e-satnice.</p>

	{
		certilia && (
			<a class="gumb" href={`/auth/certilia/start?natrag=${encodeURIComponent(natrag)}`}>
				Prijava s Certilijom
			</a>
		)
	}
	{
		certilia && (
			<p class="meta">
				<a href={VODIC}>Nemaš Certiliju ili ne znaš lozinku?</a> · <a href="/upute">Kako se prijaviti</a>
			</p>
		)
	}
	<div data-passkey>
		<button id="passkey-prijava" type="button" class="sporedni" data-natrag={natrag}>
			Prijava pristupnim ključem
		</button>
		<p class="meta">Ako je ključ na ovom uređaju već dodan nakon prijave Certilijom.</p>
		<p id="passkey-poruka" class="greska" hidden></p>
	</div>
	{certiliaGreska && <p class="greska">{GRESKE[certiliaGreska] ?? `Prijava nije uspjela (${certiliaGreska}).`}</p>}
	{
		nijeUspjelo && (
			<div class="kartica">
				<strong>Prijava s Certilijom nije prošla?</strong>
				<p class="meta">
					Najčešće fali aplikacija Certilia mobileID ili lozinka Certilia računa. Vodič kroz nekoliko pitanja pokaže
					što ti treba i vrati te ovamo.
				</p>
				<a href={VODIC}>Otvori vodič</a>
			</div>
		)
	}
	{
		debugClaimovi && (
			<div class="kartica">
				<strong>Certilia debug</strong>
				<div class="meta">Claimovi: {debugClaimovi}</div>
				<div class="meta">
					OIB iz: {p.get('oib_izvor')}, 11 znamenki: {p.get('oib_11_znamenki')}
				</div>
			</div>
		)
	}
</Osnova>

<script>
	import '../lib/passkey-klijent';
</script>

<style>
	.gumb {
		display: inline-block;
		margin: 8px 0 16px;
		padding: 12px 20px;
		border-radius: 8px;
		background: var(--plava);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	.sporedni {
		margin: 0 0 4px;
		background: none;
		color: var(--plava);
		border: 1px solid var(--plava);
	}
</style>

---
import PopisSekcija from '../../components/PopisSekcija.astro';
import Osnova from '../../layouts/Osnova.astro';
import { ucitajSekcije } from '../../lib/sekcije';

export const prerender = false;

const sekcije = await ucitajSekcije();
---

<Osnova naslov="Specifikacija" sekcije={sekcije}>
	<h1>Specifikacija</h1>
	<p>
		Radna verzija. Uz svaku sekciju upiši komentar, zahtjev ili pitanje. Prihvaćene stavke skupljamo u pakete i iz
		njih radimo iduću iteraciju.
	</p>
	<p class="meta samo-desktop">Odaberi sekciju lijevo.</p>
	<div class="samo-mobitel">
		<PopisSekcija sekcije={sekcije} />
	</div>
</Osnova>

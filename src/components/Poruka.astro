---
// Poruka nakon unosa. U adresi je samo kod, a tekst je iz popisa: tako se u stranicu
// ne može podmetnuti proizvoljan tekst preko poveznice.
import { PORUKE } from '../lib/unos';

const upit = Astro.url.searchParams;
const ok = upit.get('ok');
const greska = upit.get('greska');
const kod = greska ?? ok ?? '';
const tekst = Object.hasOwn(PORUKE, kod) ? PORUKE[kod] : undefined;
---

{
	tekst && (
		<p class:list={['poruka', { greska: Boolean(greska) }]} role={greska ? 'alert' : 'status'}>
			{tekst}
		</p>
	)
}

<style>
	.poruka {
		max-width: 72ch;
		margin: 0 0 20px;
		padding: 10px 14px;
		font-weight: 600;
		color: var(--zeleno);
		border: 2px solid currentColor;
		border-radius: 6px;
	}
	.poruka.greska {
		color: var(--crveno);
	}
</style>

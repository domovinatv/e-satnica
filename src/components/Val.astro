---
// Valovi i otoci na dnu plave podloge, prijelaz u boju stranice.
interface Props {
	/** Niži val za unutarnje stranice; naslovnica ima viši. */
	nisko?: boolean;
}
const { nisko = false } = Astro.props;
---

<svg class:list={['val', { nisko }]} viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
	<path class="val-iza" d="M0 58 C 180 40, 360 74, 540 58 S 900 40, 1080 56 S 1320 70, 1440 54 V120 H0 Z"></path>
	<path class="otok" d="M190 60 C 222 30, 288 28, 336 58 Z"></path>
	<path class="otok" d="M970 57 C 992 38, 1038 36, 1072 55 Z"></path>
	<path class="otok" d="M1176 60 C 1192 49, 1214 49, 1232 60 Z"></path>
	<path class="val-ispred" d="M0 86 C 220 62, 440 110, 720 86 S 1180 62, 1440 88 V120 H0 Z"></path>
</svg>

<style>
	.val {
		display: block;
		width: 100%;
		height: clamp(48px, 8vw, 110px);
		margin-top: 8px;
	}
	.val.nisko {
		height: clamp(30px, 5vw, 68px);
		margin-top: 4px;
	}
	.val-iza {
		fill: rgb(255 255 255 / 0.08);
	}
	.otok {
		fill: rgb(255 255 255 / 0.15);
	}
	.val-ispred {
		fill: var(--papir);
	}
</style>
